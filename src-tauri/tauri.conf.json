{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemPilot",
  "version": "0.0.2",
  "identifier": "com.systempilot.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SystemPilot",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": [
      "resources/WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SystemPilot",
    "copyright": "Copyright (c) 2026 SystemPilot Contributors",
    "category": "Utility",
    "shortDescription": "Windows System Monitoring & Performance Optimization Suite",
    "longDescription": "SystemPilot is a lightweight, professional Windows system monitoring, memory management, and performance utility.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128.png",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}
