{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemPilot",
  "version": "1.0.0",
  "identifier": "com.systempilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SystemPilot",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SystemPilot",
    "copyright": "Copyright (c) 2026 SystemPilot Contributors",
    "category": "Utility",
    "shortDescription": "Windows System Monitoring & Performance Optimization Suite",
    "longDescription": "SystemPilot is a lightweight, professional Windows system monitoring, memory management, and performance utility.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128.png",
        "displayLanguageSelector": false,
        "startMenuFolder": "SystemPilot"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
