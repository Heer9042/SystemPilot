# =============================================================================
# SystemPilot — Universal Windows System Management Platform
# Environment Configuration Template (.env.example)
# Version: 0.0.2
# =============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' in the project root for local development overrides.
# The installed desktop application runs 100% offline-first and does NOT require
# a .env file; all settings use secure, validated defaults when omitted.
#
# RULES:
# - Frontend variables MUST begin with 'VITE_' to be accessible via import.meta.env.
# - NEVER store credentials, private keys, or passwords in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & DEBUGGING
# -----------------------------------------------------------------------------
# Execution mode of the application.
# Scope: [Frontend & Build Tools]
# Values: development | production | test
# Default: development
APP_ENV=development

# Enables verbose UI debug logs and developer diagnostic overlays.
# Scope: [Frontend & Build Tools]
# Values: true | false
# Default: true (in development), false (in production)
APP_DEBUG=true

# -----------------------------------------------------------------------------
# 2. DEVELOPMENT SERVER & PORTS
# -----------------------------------------------------------------------------
# Port for the local Vite frontend development server.
# Must match the 'devUrl' configured in src-tauri/tauri.conf.json (http://127.0.0.1:1420).
# Scope: [Build Tools / Vite Server]
# Values: 1024 - 65535
# Default: 1420
APP_PORT=1420

# Host binding address for the local development server.
# Kept to localhost (127.0.0.1) for local security isolation.
# Scope: [Build Tools / Vite Server]
# Default: 127.0.0.1
VITE_DEV_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# 3. UI REFRESH & POLLING RATES
# -----------------------------------------------------------------------------
# Primary telemetry sampling interval for CPU, RAM, Disk, and Network (milliseconds).
# Automatically clamped between 500ms and 60000ms to prevent UI thread starvation.
# Scope: [Frontend]
# Values: 500 - 60000
# Default: 1000
VITE_DEFAULT_REFRESH_MS=1000

# Background process list refresh interval (milliseconds).
# Polling Toolhelp/ntdll process snapshots is heavier than basic CPU metrics.
# Scope: [Frontend]
# Values: 1000 - 60000
# Default: 2000
VITE_PROCESS_REFRESH_MS=2000

# -----------------------------------------------------------------------------
# 4. HARDWARE INFORMATION & SENSOR MONITORING
# -----------------------------------------------------------------------------
# User preference flag for polling thermal sensors and fan tachometers.
# NOTE: Setting this to true does NOT guarantee sensors exist; SystemPilot
# dynamically queries real ACPI/EC/WMI thermal zones and reports capability status honestly.
# Scope: [Frontend]
# Values: true | false
# Default: true
VITE_ENABLE_HARDWARE_SENSORS=true

# User preference flag for polling dedicated and integrated GPU telemetry (DXGI/NVML).
# Scope: [Frontend]
# Values: true | false
# Default: true
VITE_ENABLE_GPU_MONITORING=true

# -----------------------------------------------------------------------------
# 5. LOGGING & DIAGNOSTICS
# -----------------------------------------------------------------------------
# Minimum logging threshold for client-side events forwarded to Rust logging backend.
# Scope: [Frontend & Backend]
# Values: debug | info | warn | error
# Default: info
VITE_LOG_LEVEL=info

# Display capability badges (Supported, Read-Only, Permission Required, etc.) on UI cards.
# Scope: [Frontend]
# Values: true | false
# Default: false
VITE_ENABLE_DIAGNOSTIC_OVERLAYS=false

# -----------------------------------------------------------------------------
# 6. PERFORMANCE & RESOURCE LIMITS
# -----------------------------------------------------------------------------
# Maximum telemetry history points retained in frontend memory charts.
# Clamped between 10 and 120 points to prevent DOM and SVG memory bloat.
# Scope: [Frontend]
# Values: 10 - 120
# Default: 30
VITE_MAX_TELEMETRY_POINTS=30

# Minimum stack size override for Rust compiler, build scripts, and native workers (bytes).
# 16 MB stack prevents recursion overflows during deep Windows API directory and registry walks.
# Scope: [Rust Backend & Build Tools]
# Values: integer (bytes)
# Default: 16777216 (16 MB)
RUST_MIN_STACK=16777216

# -----------------------------------------------------------------------------
# 7. FEATURE FLAGS
# -----------------------------------------------------------------------------
# Toggle visibility of the Hardware Benchmark & Stress Testing module.
# Scope: [Frontend]
# Values: true | false
# Default: true
VITE_FEATURE_BENCHMARK=true

# Toggle visibility of the Fan Speed & Smart Cooling management module.
# Scope: [Frontend]
# Values: true | false
# Default: true
VITE_FEATURE_FAN_CONTROL=true

# Toggle visibility of the Temporary Cache & Disk Cleanup module.
# Scope: [Frontend]
# Values: true | false
# Default: true
VITE_FEATURE_SYSTEM_CLEANUP=true

# -----------------------------------------------------------------------------
# 8. OPTIONAL UPDATE CONFIGURATION
# -----------------------------------------------------------------------------
# Query GitHub releases API for software updates on startup.
# Disabled by default to respect offline-first user privacy.
# Scope: [Frontend & Backend]
# Values: true | false
# Default: false
VITE_AUTO_CHECK_UPDATES=false

# Update check frequency in hours when auto-checking is enabled.
# Scope: [Frontend & Backend]
# Values: 1 - 168
# Default: 24
VITE_UPDATE_CHECK_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# 9. OPTIONAL TELEMETRY & PRIVACY SETTINGS
# -----------------------------------------------------------------------------
# Enforce strict offline-first operation. SystemPilot transmits zero usage statistics,
# crash reports, or machine identifiers outside the user's computer.
# Scope: [Frontend & Backend]
# Values: false (permanently enforced)
# Default: false
VITE_ALLOW_EXTERNAL_CONNECTIONS=false

# -----------------------------------------------------------------------------
# 10. OPTIONAL EXTERNAL SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# SystemPilot is a self-contained, standalone Windows system management platform.
# It does not integrate with cloud databases, external analytics, SaaS services,
# or remote API backends. No cloud service credentials or endpoint URLs are required.
# =============================================================================
